{
  "name": "@skiyer/dsh-pi-context",
  "version": "1.0.5",
  "type": "module",
  "description": "pi context management for DeepSeek Harness: tool set, codemode, MCP exposure, prompt sections and compaction.",
  "exports": {
    ".": "./index.js",
    "./compaction": "./compaction.js",
    "./guard": "./guard.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./mcp-config": "./mcp-config.js",
    "./client": "./client.js",
    "./settings": "./settings.js"
  },
  "files": [
    "index.js",
    "compaction.js",
    "guard.js",
    "settings.js",
    "client.js",
    "mcp-config.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@earendil-works/pi-codemode": "1.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skiyer/dsh-pi-context.git"
  },
  "homepage": "https://github.com/skiyer/dsh-pi-context#readme",
  "bugs": {
    "url": "https://github.com/skiyer/dsh-pi-context/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
